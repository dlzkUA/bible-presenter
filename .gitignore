# Dependencies — reinstalled by npm install, never committed
node_modules/

# Build output; release/ holds the files for a GitHub release (scripts/release.js)
src-tauri/target/
src-tauri/gen/
dist/
release/

# Both lockfiles ARE committed: package-lock.json and src-tauri/Cargo.lock pin
# every library to an exact version and checksum, so a release build can't
# silently pick up a new (possibly hijacked) version.

# OS noise
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/

# Local secrets — never commit a signing key or a token
.env
*.key
*.key.pub.bak
*.pem
*.p12

# Generated copy of the guide for Notion import (images duplicated) — build it locally
docs/manual/import/
